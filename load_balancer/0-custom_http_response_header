#!/usr/bin/env bash
# Installs nginx and adds an X-Served-By header containing the server hostname
sudo apt-get update -y
sudo apt-get install -y nginx
echo "Holberton School" | sudo tee /var/www/html/index.html > /dev/null
echo "Ceci n'est pas une page" | sudo tee /var/www/html/404.html > /dev/null
sudo sed -i '/server_name _;/a\    add_header X-Served-By $hostname;\n    error_page 404 /404.html;' /etc/nginx/sites-available/default
sudo service nginx restart
